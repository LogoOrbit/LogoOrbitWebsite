# Copy to .env.local for development, and set the same keys in the hosting
# environment for production. .env.local is gitignored; this file is not, so
# never put a real value in it.

# --- transactional email (contact, order, brief, trademark forms) -----------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- client portal (/clients) ----------------------------------------------
# Guards the issued client certificates in clients/. It works with none of
# these set: lib/clientPortal.js carries a committed scrypt digest of the
# shared password, so a fresh deploy needs no hosting config. Rotate it with
#   node tools/portal-password.mjs 'the new password'
#
# Set these to override the committed digest. Worth doing when the certificates
# move somewhere the repository does not carry them, or when someone gets repo
# access who should not have client documents - at that point the digest and
# the derived cookie key stop being good enough on their own.
CLIENT_PORTAL_USER=
CLIENT_PORTAL_PASSWORD=
CLIENT_PORTAL_SECRET=
