# Copy to .env.local for development, and set the same keys in the hosting
# environment for production. .env.local is gitignored; this file is not, so
# never put a real value in it.

# --- transactional email (contact, order, brief, trademark forms) -----------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- client portal (/clients) ----------------------------------------------
# Guards the issued client certificates in clients/. Those documents carry a
# client's legal name and postal address, so there is deliberately no default
# password: with CLIENT_PORTAL_PASSWORD unset the portal answers 503 and shows
# a "not configured" notice rather than opening on a value committed here.
#
# CLIENT_PORTAL_USER defaults to `logoorbitclients` when unset.
# CLIENT_PORTAL_SECRET is optional; when unset, the cookie signing key is
# derived from the password, so changing the password signs everyone out.
CLIENT_PORTAL_USER=
CLIENT_PORTAL_PASSWORD=
CLIENT_PORTAL_SECRET=
